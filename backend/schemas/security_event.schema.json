{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityEvent",
  "description": "安全事件 Schema (JSON 表达) — 权威契约。Flink Avro / Java POJO 由 CI 对齐。schemaVersion 等信封字段为可选，历史扁平消息继续有效。",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "事件唯一标识 (UUID)"
    },
    "sourceId": {
      "type": "string",
      "description": "日志来源标识"
    },
    "apiKey": {
      "type": "string",
      "description": "数据源认证密钥"
    },
    "eventType": {
      "type": "string",
      "description": "事件类型枚举"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "srcIp": {
      "type": [
        "string",
        "null"
      ]
    },
    "dstIp": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string",
      "description": "事件描述 (最长 500 字符)"
    },
    "confidence": {
      "type": "number",
      "description": "置信度 [0, 100]"
    },
    "timestamp": {
      "type": "integer",
      "description": "事件时间戳 (epoch millis, 2020~2030)"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "anomalyScore": {
      "type": "number",
      "description": "Flink 异常评分 (富化后附加)"
    },
    "anomalyReasons": {
      "type": [
        "array",
        "null"
      ]
    },
    "rawData": {
      "type": [
        "object",
        "null"
      ],
      "description": "原始日志字段 (透传, 含 Flink _anomalyScore)"
    },
    "schemaVersion": {
      "type": [
        "string",
        "null"
      ],
      "description": "事件结构版本 (semver)，缺省视为 1.0.0"
    },
    "producer": {
      "type": [
        "string",
        "null"
      ],
      "description": "生产方标识"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "同一业务处理过程的关联 ID"
    },
    "occurredAt": {
      "type": [
        "integer",
        "null"
      ],
      "description": "事件产生时间 (epoch millis)"
    },
    "parentEventId": {
      "type": [
        "string",
        "null"
      ],
      "description": "派生事件指向的来源业务事件 ID (可空: Avro 声明 [\"null\",\"string\"] default null, 与 flink-jobs/schemas/security-event.avsc 对齐)"
    },
    "dnsQuery": {
      "type": [
        "string",
        "null"
      ],
      "description": "路线4(2026-10-27): 查询域名(Suricata dns.rrname/Zeek query/Sysmon EID22 QueryName)。SigmaHQ dns 类别规则的 query 字段经 mapping.py dns_query 别名命中。"
    },
    "fileHash": {
      "type": [
        "string",
        "null"
      ],
      "description": "路线4(2026-10-27): 文件哈希(sha256 优先)。第二批 Sysmon 数据源字段的预铺通道(当前类别无 hash 规则)。"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "severity",
    "message",
    "timestamp"
  ],
  "additionalProperties": true
}
