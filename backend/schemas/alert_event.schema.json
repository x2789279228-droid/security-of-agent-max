{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertEvent",
  "description": "安全告警 Schema (JSON 表达) — 权威契约。schemaVersion 等信封字段为可选。",
  "x-schema-version": "1.0.0",
  "type": "object",
  "properties": {
    "alertId": { "type": "string", "description": "告警唯一标识" },
    "eventType": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "srcIp": { "type": ["string", "null"] },
    "dstIp": { "type": ["string", "null"] },
    "message": { "type": "string" },
    "anomalyScore": { "type": "number", "description": "异常评分 [0, 1]" },
    "alertType": { "type": "string", "enum": ["ANOMALY", "ATTACK_CHAIN", "THRESHOLD"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "evidenceEventIds": { "type": ["array", "null"] },
    "evidenceChain": { "type": ["array", "null"] },
    "timeSpanMs": { "type": "integer" },
    "timestamp": { "type": "integer", "description": "告警时间戳 (epoch millis)" },
    "traceId": { "type": ["string", "null"] },
    "schemaVersion": { "type": "string", "description": "事件结构版本 (semver)，缺省视为 1.0.0" },
    "producer": { "type": "string", "description": "生产方标识" },
    "correlationId": { "type": "string", "description": "同一业务处理过程的关联 ID" },
    "occurredAt": { "type": "integer", "description": "事件产生时间 (epoch millis)" },
    "parentEventId": { "type": "string", "description": "派生告警指向的来源业务事件 ID" }
  },
  "required": ["alertId", "eventType", "severity", "message", "anomalyScore", "alertType", "timestamp"],
  "additionalProperties": true
}
