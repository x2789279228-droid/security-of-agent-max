# ══ .env.demo.example — 演示用 B 类高级能力一键开启 ══
#
# 用法(在项目根):
#   docker compose --env-file .env --env-file .env.demo ?  # 多 env-file 时后者覆盖
# 或(独立演示):
#   cp .env .env.demo && cat .env.demo.example >> .env.demo
#   docker compose --env-file .env.demo up
#
# 说明:
#   - 本文件只放"开启 B 类能力"的覆盖项; 基础(.env)值仍由 .env 提供。
#   - NDR 需 scapy 抓包权限(容器内需 root + 网卡); 无权限时采集模块仅 log 不崩溃,
#     演示可用 Phase 3 的样本注入脚本灌入 NDR 流(见 tests/inc_testcases.py)。
#   - 0day 沙箱演示用本地 mock CAPE(见 tests/inc_mock_servers.py), 无需真实 CAPE。

# ── NDR 流量分析 ──
SHARED_MEMORY_CAPTURE_ENABLED=true
SHARED_MEMORY_CAPTURE_INTERFACE=eth0
SHARED_MEMORY_CAPTURE_METHOD=libpcap

# ── EDR 融合 ──
SHARED_MEMORY_EDR_ENABLED=true

# ── 威胁情报 (演示: 无外部 MISP/TAXII 时保持 false, 用 Phase 3 注入 IOC) ──
SHARED_MEMORY_INTEL_ENABLED=true

# ── 0day 沙箱 (演示: 指向本地 mock CAPE) ──
SHARED_MEMORY_SANDBOX_ENABLED=true
SHARED_MEMORY_SANDBOX_TYPE=cape
SHARED_MEMORY_SANDBOX_API_URL=http://host.docker.internal:8899

# ── 反钓鱼 (PhishingGuard 常开, 无独立 enable; 仅控制 LLM 增强) ──
SHARED_MEMORY_LLM_PHISHING_ENABLED=false

# ── 响应执行（仅限隔离靶场；默认 dry_run）──
# 真实封禁/隔离需要显式开启，并确保目标 SSH 主机密钥已登记。
# 生产环境不要打开 ALLOW_UNKNOWN_HOST；应使用 known_hosts。
# SHARED_MEMORY_EXECUTION_MODE=live
# SHARED_MEMORY_FW_SSH_ALLOW_UNKNOWN_HOST=true
# SHARED_MEMORY_RESPONSE_SSH_ALLOW_UNKNOWN_HOST=true

# ── 公开注册（仅演示；默认关闭）──
# SHARED_MEMORY_ALLOW_SELF_REGISTRATION=true
