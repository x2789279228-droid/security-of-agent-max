# ════════════════════════════════════════════
# 共享记忆安全审计 Agent 平台 — 环境变量模板
# 复制为 .env 并填入真实值
# ════════════════════════════════════════════

# ── 部署模式 (CI/CD) ──
# 开发:   docker compose up -d --build                       (默认 IMAGE_TAG=dev)
# 生产:   docker compose -f docker-compose.yml -f docker-compose.prod.yml pull
#         IMAGE_TAG=<发布标签> docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# IMAGE_TAG 默认 dev; 生产部署必须显式指定 GHCR 已发布的标签 (main / sha-xxxxxx / 语义版本)
IMAGE_TAG=dev

# ── 数据库 ──
POSTGRES_PASSWORD=your-strong-password
SHARED_MEMORY_DATABASE_URL=postgresql+asyncpg://admin:${POSTGRES_PASSWORD}@localhost:5432/shared_memory

# ── Redis (必填; 端口仅绑 127.0.0.1, 容器间走 Docker 内网) ──
REDIS_PASSWORD=your-redis-password
SHARED_MEMORY_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ── JWT 认证 (必填) ──
SHARED_MEMORY_JWT_SECRET=your-random-jwt-secret
SHARED_MEMORY_ADMIN_PASSWORD=your-admin-password
# ⚠️ 凭据轮换警示 (2026-10-24 审查 P0-5): git 历史中曾泄露过真实口令与 LLM API Key
#    (tools/monitor-2026-09-10.py 旧版硬编码, 代码已改为环境变量读取)。
#    部署前必须: ① 全部使用全新随机口令/密钥; ② 若曾用过历史版本携带的口令, 立即轮换;
#    ③ 有条件时用 git filter-repo 清理历史。详见 docs/PRODUCTION_HARDENING_REVIEW_2026-10-24.md。
# 控制面 HMAC 密钥 — 用于审批票据签名 + 审计哈希链。
# 2026-10-03 审计 P0-6: 原实现在此为空时回退到源码里的公开常量
# b"dev-hmac-unconfigured", 导致审计"防篡改"与审批签名均可伪造。
# 修复后: 留空且 JWT_SECRET 也为空 → 启动即失败(拒绝以公开密钥运行)。
# 强烈建议生成独立值(与 JWT_SECRET 不同), 消除密钥复用。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SHARED_MEMORY_CONTROL_HMAC_KEY=change-me-to-a-separate-random-value

# ── 安全默认(2026-10-03 审计加固) ──
# 说明: 以下三项此前【不在本文件中】, 意味着演示环境一直静默使用代码里
#       最危险的那个默认值。以下为安全默认; 演示/联调按需覆盖。
#
# 响应引擎执行模式: dry_run | mock | live
#   原默认 "live" —— 未配置即会对真实目标下发 iptables/netsh。
#   现默认 dry_run; 需要真实响应时【显式】设为 live。
SHARED_MEMORY_EXECUTION_MODE=dry_run

# 自助注册: true | false
#   原先 /api/auth/register 恒定公开(任何人一次请求即得有效账号),
#   且全项目没有任何修改角色/停用用户的 API —— 门开着又用不了。
#   现默认关闭; 演示需要自助注册时在 .env.demo 中显式开启。
SHARED_MEMORY_ALLOW_SELF_REGISTRATION=false

# ── 数据源认证 (2026-10-23 起必读) ──
# 源码内置的演示密钥已删除 (公开仓库里谁能读到源码, 谁就能伪装成合法日志源)。
# 现在默认空 = 无预置来源 (fail-closed)。以下为【演示专用】值, 生产必须
# 全部替换为私有密钥并同步更新 Flink 的 VALID_API_KEYS (逗号分隔, 同一集合)。
# 生成: python -c "import secrets; print('soc-' + secrets.token_urlsafe(24))"
SHARED_MEMORY_SOURCE_API_KEYS={"soc-syslog-2024":"syslog-adapter","soc-api-2024":"api-client","soc-simulator-2024":"log-simulator"}
# Flink LogValidationJob 白名单 (与上面 JSON 的 key 集合一致)
VALID_API_KEYS=change-me-invalidate-external-api-key

# ── 数据库迁移 / 日志格式 ──
# 启动时自动执行 alembic upgrade head (生产建议 true; 迁移失败将阻止启动)
SHARED_MEMORY_AUTO_MIGRATE=true
# 日志格式: 空=按环境自动 (prod=json 结构化, 其余=text); 可显式 json | text
SHARED_MEMORY_LOG_FORMAT=

# ── LLM API ──
SHARED_MEMORY_LLM_API_KEY=your-llm-api-key
SHARED_MEMORY_LLM_BASE_URL=https://your-llm-endpoint/v1
SHARED_MEMORY_LLM_MODEL=mimo-v2.5

# ── Copilot 对话式安全助手 (2026-11 AI Web 改造) ──
# 视觉模型（图像理解）：空 = 视觉能力关闭，Copilot 前端置灰并如实说明原因。
# 需与 LLM_BASE_URL 同网关的 OpenAI 兼容视觉模型，例: glm-4v / gpt-4o-mini
SHARED_MEMORY_LLM_VISION_MODEL=
# 会话历史最多带入轮数（默认 6）与知识库引用条数上限（默认 4）
SHARED_MEMORY_COPILOT_HISTORY_MAX_TURNS=6
SHARED_MEMORY_COPILOT_RAG_TOP_K=4

# ── LLM 成本控制 (可选, 均有默认值) ──
# 每日全局 token 预算: 超限后 LLM 调用降级为 fallback (默认 5,000,000)
SHARED_MEMORY_LLM_DAILY_BUDGET_TOKENS=5000000          # 日 token 预算(默认 5M 有界; 0=无上限)
# 输入/输出每千 token 单价(¥): >0 时运营中心「Token 成本」面板展示估算费用; 均为 0 则不估算
# 参考: Xiaomi MiMo V2.5 (mimo-v2.5) 国内价 — 输入 ¥1.00/百万tokens, 输出 ¥2.00/百万tokens
#   → 输入 0.001 ¥/1K, 输出 0.002 ¥/1K
#   → 若用 mimo-v2.5-pro: 输入 0.003 ¥/1K, 输出 0.006 ¥/1K
SHARED_MEMORY_LLM_BUDGET_UNLIMITED=false                # false=硬门禁(默认, 超限低优降级/P0 保留); true=只记账不关(成本无界)
SHARED_MEMORY_LLM_PRICE_INPUT_PER_1K_TOKENS=0.001
SHARED_MEMORY_LLM_PRICE_OUTPUT_PER_1K_TOKENS=0.002

# ── Embedding API ──
SHARED_MEMORY_EMBEDDING_API_KEY=your-embedding-api-key
SHARED_MEMORY_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
SHARED_MEMORY_EMBEDDING_MODEL=your-embedding-model
# 必须与当前 embedding 模型实际输出维度一致（不一致会导致 pgvector 768/1536 冲突）
SHARED_MEMORY_EMBEDDING_DIM=768

# ── Qdrant 向量数据库 (RAG 检索; 可选, 留空 qdrant_url 则回退 pgvector) ──
# 容器内默认 http://qdrant:6333; 本机调试可用 http://127.0.0.1:6333
SHARED_MEMORY_QDRANT_URL=
SHARED_MEMORY_QDRANT_COLLECTION=soc_knowledge_chunks
SHARED_MEMORY_QDRANT_ENABLED=true
# 与 embedding 维度一致(768)
SHARED_MEMORY_QDRANT_VECTOR_SIZE=768

# ── RAG 重排（默认不拉 Infinity）──
# 空 URL = BM25 + RRF + 特征重排，不依赖 michaelf34/infinity 镜像。
# 若要神经网络 CE：先拉镜像再 --profile rerank（见 docker-compose.yml 注释）。
SHARED_MEMORY_RAG_RERANK_URL=
# SHARED_MEMORY_RAG_RERANK_URL=http://soc-bge-rerank:7997/rerank
# INFINITY_IMAGE=docker.m.daocloud.io/michaelf34/infinity:latest
# HF_ENDPOINT=https://hf-mirror.com

# ── AI 进阶调优（2026-11-09 补全: 以下均有代码默认值, 按需覆盖） ──
# LLM 推理力度/超时/重试/限流
SHARED_MEMORY_LLM_REASONING_EFFORT=none
SHARED_MEMORY_LLM_SLOT_TIMEOUT_S=30
SHARED_MEMORY_LLM_REQUEST_TIMEOUT_S=90
SHARED_MEMORY_LLM_CONNECT_TIMEOUT_S=10
SHARED_MEMORY_LLM_RETRY_BASE_S=0.5
SHARED_MEMORY_LLM_RETRY_MAX_S=8
SHARED_MEMORY_LLM_429_RETRY_S=1
SHARED_MEMORY_LLM_RATE_PER_MINUTE=600
# LLM/Embedding 响应缓存 TTL(秒)
SHARED_MEMORY_LLM_CACHE_TTL=86400
SHARED_MEMORY_EMBEDDING_CACHE_TTL=3600
# Qdrant 细项
SHARED_MEMORY_QDRANT_TIMEOUT=5
SHARED_MEMORY_QDRANT_MEMORIES_COLLECTION=agent_memories
# RAG 混合检索调优(dense+sparse RRF)
SHARED_MEMORY_RAG_HYBRID_ENABLED=true
SHARED_MEMORY_RAG_RRF_K=60
SHARED_MEMORY_RAG_PREFETCH=20
SHARED_MEMORY_RAG_BM25_BACKEND=builtin
# 查询改写: off | rules | llm (llm 需消耗 token)
SHARED_MEMORY_RAG_QUERY_REWRITE=rules
# HyDE: off | empty_only | always
SHARED_MEMORY_RAG_HYDE=empty_only
# CE 重排(配合 RAG_RERANK_URL)
SHARED_MEMORY_RAG_RERANK_ENABLED=true
SHARED_MEMORY_RAG_RERANK_API_KEY=
SHARED_MEMORY_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SHARED_MEMORY_RAG_RERANK_TOP_N=20
# 业务增强 LLM 开关(默认全关, 打开前确认预算)
SHARED_MEMORY_LLM_TRAFFIC_ENABLED=false
SHARED_MEMORY_LLM_ENHANCER_CONCURRENCY=8
SHARED_MEMORY_LLM_ENHANCER_TIMEOUT_SEC=15
SHARED_MEMORY_INTEL_LLM_CONTEXT_ENABLED=false
SHARED_MEMORY_EDR_LLM_CORRELATION_ENABLED=false
# 单跳快审车道超时(P1/P2 主路径)
SHARED_MEMORY_AUDIT_LLM_SINGLE_TIMEOUT_S=15

# ── Temporal (4 层 Agent 编排: 可靠性/长任务/可视化; 可选, 默认启用, 失败降级 async) ──
# Temporal 编排；若 temporal 容器异常可先设 false，HTTP Audit-LLM 异步路径仍可用
SHARED_MEMORY_TEMPORAL_ENABLED=true
SHARED_MEMORY_TEMPORAL_HOST=temporal:7233
SHARED_MEMORY_TEMPORAL_NAMESPACE=default
SHARED_MEMORY_TEMPORAL_TASK_QUEUE=audit-pipeline
# compose 必填(fail-closed, P1-14): temporal 与 temporal-postgres 共用
TEMPORAL_PASSWORD=

# ── 演示模式 (R12) ──
# 只有显式 true 才挂载 /api/demo/seed|clear|status; 演示完关掉即彻底退出演示态
SHARED_MEMORY_DEMO_MODE=false

# ── Red vs Blue Self-Play (红队仿真对抗 + 蓝队学习; 默认不注入生产流水线) ──
SHARED_MEMORY_SELF_PLAY_ENABLED=true
SHARED_MEMORY_SELF_PLAY_DEFAULT_ROUNDS=8
SHARED_MEMORY_SELF_PLAY_INJECT=false
SHARED_MEMORY_SELF_PLAY_USE_LLM=false
# 演示自适应对抗时改为 true: RAG 召回 ATT&CK 候选 + LLM 多步链; 默认 false 保证 CI/离线可复现
SHARED_MEMORY_SELF_PLAY_WAIT_AUDIT=false
SHARED_MEMORY_SELF_PLAY_DECOY_RATIO=0.2
SHARED_MEMORY_SELF_PLAY_MAX_INFLIGHT=1
SHARED_MEMORY_SELF_PLAY_RAG_TOP_K=8
SHARED_MEMORY_SELF_PLAY_LLM_TIMEOUT_S=20
SHARED_MEMORY_SELF_PLAY_REVIEW_ENABLED=true
SHARED_MEMORY_SELF_PLAY_REVIEW_FP_MAX=0.05
SHARED_MEMORY_SELF_PLAY_REVIEW_LLM=true
SHARED_MEMORY_SELF_PLAY_REVIEW_REPLAY=true
SHARED_MEMORY_SELF_PLAY_SHADOW_HOURS=24
SHARED_MEMORY_SELF_PLAY_REVIEW_INTERVAL_S=900
SHARED_MEMORY_SELF_PLAY_REVIEW_BATCH=20

# ── MCP Guard / Tool 行为签名 (UEBA-for-AI; 默认 confirm=enforce，偏离需人工确认) ──
SHARED_MEMORY_MCP_GUARD_ENABLED=true
SHARED_MEMORY_TOOL_CALL_LOG_PERSIST=true
SHARED_MEMORY_TOOL_SIGNATURE_ENABLED=true
SHARED_MEMORY_TOOL_SIGNATURE_MODE=confirm
SHARED_MEMORY_TOOL_SIGNATURE_MIN_SAMPLES=30
SHARED_MEMORY_TOOL_SIGNATURE_WARN_THRESHOLD=0.6
SHARED_MEMORY_TOOL_SIGNATURE_CONFIRM_THRESHOLD=0.8
SHARED_MEMORY_TOOL_SIGNATURE_DENY_THRESHOLD=0.95
SHARED_MEMORY_TOOL_SIGNATURE_LOG_RETENTION_DAYS=180
SHARED_MEMORY_TOOL_SIGNATURE_WEIGHTS=param:0.35,seq:0.25,time:0.15,caller:0.25

# ── 因果攻击链 (PC/GES 批式结构学习; 不进 Flink 热路径, 不自动封禁) ──
SHARED_MEMORY_CAUSAL_ENABLED=true
SHARED_MEMORY_CAUSAL_BIN_MINUTES=30
SHARED_MEMORY_CAUSAL_ALPHA=0.05
SHARED_MEMORY_CAUSAL_MIN_WINDOWS=40
SHARED_MEMORY_CAUSAL_LEARN_INTERVAL_S=900
SHARED_MEMORY_CAUSAL_LOOKBACK_HOURS=48
# 演示流量心跳：默认关。true 时每 N 秒 ingest 1 条带 _demo 的仿真事件（不写生产 Sigma）
SHARED_MEMORY_DEMO_TRAFFIC_ENABLED=false
SHARED_MEMORY_DEMO_TRAFFIC_INTERVAL_S=300
# r6: workflow 硬超时(秒) + 全局 in-flight 上限(超限时低优降级)
SHARED_MEMORY_TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT_S=120
SHARED_MEMORY_AUDIT_INFLIGHT_MAX=12
SHARED_MEMORY_STUCK_AUDIT_REAP_MINUTES=5
# LLM 通道分层: 软/硬预算水位; 硬水位仍保留 P0 最小 LLM hop
SHARED_MEMORY_AUDIT_SOFT_BUDGET_PCT=70
SHARED_MEMORY_AUDIT_HARD_BUDGET_PCT=95
SHARED_MEMORY_AUDIT_P0_RESERVE_PCT=0.25
SHARED_MEMORY_AUDIT_FASTPATH_DEMOTE=true
# 优先级队列: inflight 满时 P0/P1 等待; 分档 TTL
SHARED_MEMORY_AUDIT_PQ_TTL_S=900
SHARED_MEMORY_AUDIT_PQ_TTL_P0_S=3600
SHARED_MEMORY_AUDIT_PQ_TTL_P1_S=1800
SHARED_MEMORY_AUDIT_PQ_TTL_P2_S=300
SHARED_MEMORY_AUDIT_PQ_DRAIN_INTERVAL_S=1.0
# 有界审计 worker + 全局 LLM 闸 (取代 AUDIT_REVIEW_CONCURRENCY 双 Semaphore)
SHARED_MEMORY_AUDIT_WORKERS=12
SHARED_MEMORY_AUDIT_QUEUE_MAX=2000
SHARED_MEMORY_LLM_GLOBAL_CONCURRENCY=8
SHARED_MEMORY_LLM_P0_RESERVE=2
# 资源容量（入口共用，不要在代码里再写一套）。0=LLM 不再叠加每分钟速率闸。
# SHARED_MEMORY_LLM_REQUEST_TIMEOUT_S=90
# SHARED_MEMORY_LLM_RATE_PER_MINUTE=600
# SHARED_MEMORY_HTTP_INGEST_MAX_BODY_BYTES=1048576
# SHARED_MEMORY_HTTP_INGEST_MAX_BATCH=200
# SHARED_MEMORY_HTTP_INGEST_ABSOLUTE_MAX=1000
# SHARED_MEMORY_HTTP_INGEST_BATCH_POLICY=chunk
# SHARED_MEMORY_HTTP_OVERLOAD_STATUS=503
# SHARED_MEMORY_HTTP_BACKGROUND_MAX=8
# SHARED_MEMORY_AUDIT_QUEUE_HIGH_WATERMARK=0.8
# SHARED_MEMORY_AUDIT_QUEUE_LOW_WATERMARK=0.5
# ── 背压复合信号（PERF-OPT-PLAN-2026-10-26 Wave 2-1/2-2）──
# 准入闸门信号 = max(审计队列比, Kafka lag 比, PQ 深度比)；Kafka 拉取暂停仍只看审计队列
# （停拉会加深 lag —— lag 信号只拒绝新进入，不停拉）。
# KAFKA_CONSUMPTION_EPS: 实测稳态消费容量(events/s)。0=未标定 → lag 信号不启用；
# 标定口径 = PERF 压测排空段实测，lag 阈值条数 = eps × 允许积压秒数（PERF-2 复测后回填）。
# SHARED_MEMORY_KAFKA_CONSUMPTION_EPS=0
# SHARED_MEMORY_KAFKA_LAG_ALLOWED_BACKLOG_S=60
# SHARED_MEMORY_AUDIT_PQ_CAPACITY=2000
# SHARED_MEMORY_AUDIT_BATCH_CONCURRENCY=8
# SHARED_MEMORY_DB_WRITE_MAX_CONCURRENCY=8
# SHARED_MEMORY_DB_QUERY_TIMEOUT_S=30
# SHARED_MEMORY_KAFKA_PRODUCE_BATCH_SIZE=100
# SHARED_MEMORY_KAFKA_PRODUCE_MAX_INFLIGHT=32
# SHARED_MEMORY_KAFKA_PRODUCE_TIMEOUT_S=10
# SHARED_MEMORY_KAFKA_CONSUME_CONCURRENCY=1
# SHARED_MEMORY_KAFKA_MAX_POLL_RECORDS=50
# DB 双池: OLTP 短租 + 后台索引。公式: 2*(oltp+bg)*进程数 + 20 < postgres max_connections
SHARED_MEMORY_DB_POOL_OLTP_SIZE=24
SHARED_MEMORY_DB_POOL_BG_SIZE=8
# TEMPORAL_CONCURRENCY=12  (与 audit_workers 对齐)

# ═══ 生产化 profile (2026-10-24): full=3-broker KRaft(默认) / lite=单 broker ═══
# full: RF=3/minISR=2 + kafka-init(SCRAM+topic) + kafka_exporter;
# lite: 8GB 内存兜底, 仅单 broker。切换需同时改 KAFKA_BOOTSTRAP_SERVERS。
COMPOSE_PROFILES=full
# full 默认 (留空即用 compose 内置默认); lite 必须显式:
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
# Flink JM 高可用 (可选叠加, 内存 +~1.5GB):
#   docker compose -f docker-compose.yml -f docker-compose.ha.yml up -d
#   (ZK 选主 + 双 JM; 演示见 docs/upgrade/PROD-PROFILE-2026-10-24.md §10)
# 客户端数据面安全 (默认 PLAINTEXT=容器网内明文, 演示兼容; SASL_SSL=内部链路加密+认证)
#KAFKA_SECURITY_PROTOCOL=SASL_SSL
#KAFKA_APP_USER=soc-app
#KAFKA_APP_PASSWORD=your-app-scram-password
#KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=
# ── Vector 边缘代理 (COMPOSE_PROFILES 追加 edge 后 docker compose up -d vector) ──
# 外部日志源 POST http://<host>:8686 (JSON); Kafka 全停时事件落磁盘缓冲, 恢复后排干。
# SASL_SSL 切换时与 KAFKA_SECURITY_PROTOCOL 同步置 true:
#VECTOR_KAFKA_TLS=false
#VECTOR_KAFKA_SASL=false
# ── Kafka ──
SHARED_MEMORY_KAFKA_ENABLED=true
# 容器内后端经 Docker 内网连接 (full: 3-broker 集群 / lite: kafka:9092); 独立运行模式用 localhost:9094
# ⚠ lite/full 切换三件套必须配套 (2026-10-25 审计 #1: 此前 compose 用
#   KAFKA_BOOTSTRAP_SERVERS 遮蔽本变量, lite 栈下 producer 首启连不上):
#   COMPOSE_PROFILES=lite + KAFKA_BOOTSTRAP_SERVERS=kafka:9092 + 本变量=kafka:9092
#SHARED_MEMORY_KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092
# 外部监听 advertised 地址 (本机对外 IP 或域名)。
# full: EXTERNAL 监听(9094) advertised=${KAFKA_PUBLIC_HOST}:9094, 证书 SAN 需含该主机
# lite: SASL_SSL(9093) advertised=${KAFKA_PUBLIC_HOST}:9093
KAFKA_PUBLIC_HOST=your-host-ip-or-domain
KAFKA_SSL_PASSWORD=your-kafka-ssl-password
# 外部日志源 SCRAM 账号 (full: kafka-init 自动创建; lite: tools/create-kafka-users.sh)
KAFKA_LOG_SOURCE_USER=soc-log-source
KAFKA_LOG_SOURCE_PASSWORD=your-log-source-password
# Flink↔Python 跨运行时 Schema 契约 (compose 内固定 http://schema-registry:8081)
SHARED_MEMORY_SCHEMA_REGISTRY_URL=http://schema-registry:8081
# Flink JobManager REST (管道状态聚合, compose 内固定)
SHARED_MEMORY_FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081

# ── Kafka UI (必填; 8082 登录认证) ──
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=your-kafka-ui-password

# ── Grafana (必填; 经 3002/grafana/ 反代登录) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# ── 可选组件 (MISP 威胁情报, profiles=intel) ──
# 注意: compose 会对所有服务做变量插值(无论 profile 是否启用),
# 这三项必须为非空值, 否则 `docker compose config/up` 解析失败。启用 intel 时请改为强口令。
MISP_DB_PASSWORD=change-me-misp-db
MISP_ADMIN_PASSWORD=change-me-misp-admin
MISP_ROOT_PASSWORD=change-me-misp-root

# ── 响应引擎 SSH (可选; 未配置私钥则自动 stub，不会假冒 live) ──
# 容器默认读取 entrypoint 复制后的 /tmp/ssh/id_rsa（compose 挂载 ~/.ssh/id_rsa → /tmp/ssh-keys/id_rsa）
SHARED_MEMORY_RESPONSE_SSH_HOST=
SHARED_MEMORY_RESPONSE_SSH_PORT=22
SHARED_MEMORY_RESPONSE_SSH_USER=
SHARED_MEMORY_RESPONSE_SSH_KEY_FILE=/tmp/ssh/id_rsa
# L1 Uncertain：未知 threat_type 走 5 分钟短封 + P1 工单（false 时紧急回退旧 ANY 60min）
RESPONSE_UNCERTAIN_ENABLED=true
RESPONSE_UNCERTAIN_COOLDOWN_SEC=300
RESPONSE_IP_COOLDOWN_SEC=60
# L2 策略 YAML：容器默认 /data/response_policies（compose volume 持久化）
# 本地直跑可用 backend/response_engine/policies
RESPONSE_POLICIES_DIR=/data/response_policies
RESPONSE_TAXONOMY_PATH=/data/response_policies/taxonomy.yml
RESPONSE_POLICY_RELOAD_SEC=30
RESPONSE_TAXONOMY_RELOAD_SEC=30

# ── 防火墙 SSH (可选, block_ip 封禁链路) ──
# 靶标容器: docker compose --profile firewall up -d --build soc-firewall
# (2026-10-25 审计 #4: 此前 compose 无此 service, FW_SSH_HOST 指向空气)
# 演示 live 封禁三件套: 起 soc-firewall + SHARED_MEMORY_EXECUTION_MODE=live +
# ALLOW_UNKNOWN_HOST=true(靶场容器无预置 known_hosts; 生产必须改用 known_hosts 白名单)
SHARED_MEMORY_FW_SSH_HOST=
SHARED_MEMORY_FW_SSH_PORT=22
SHARED_MEMORY_FW_SSH_USER=
SHARED_MEMORY_FW_SSH_PASSWORD=
SHARED_MEMORY_FW_SSH_ALLOW_UNKNOWN_HOST=false

# ── CORS ──
SHARED_MEMORY_ALLOWED_ORIGINS=["http://localhost:3001", "http://127.0.0.1:3001"]

# ── HTTP 全局限流 (60s 滑窗; 详见 backend/http_guards.py) ──
# 策略(2026-09-10):全部业务域/运营只读端点默认豁免(运营中心 39 个域曾因共桶 429);
# 仅"不可逆高危动作 + LLM 重端点"由 RATE_LIMIT_FORCED 点名限流(独立 crit: 桶)。
#   SHARED_MEMORY_RATE_LIMIT_PER_MINUTE=120    全局阈值(每桶 60s 内允许请求数, <=0 关闭限流)
#   SHARED_MEMORY_RATE_LIMIT_WHITELIST=        追加豁免前缀(逗号分隔), 只增不减; 不改代码即可现场热调
#                                              例: /api/self-play/matches/journal,/api/custom-thing

# ── 敏感字段加密 (可选; 留空则不加密落库) ──
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHARED_MEMORY_FIELD_ENCRYPTION_KEY=

# ── CAD 独立监督阈值 (可选, 均有默认值) ──
SHARED_MEMORY_CAD_MAX_HALLUCINATION_RISK=0.5
SHARED_MEMORY_CAD_MIN_EVIDENCE_COMPLETENESS=0.3
SHARED_MEMORY_CAD_CONSECUTIVE_BAD_AUDITS=5
SHARED_MEMORY_CAD_WARMUP_AUDITS=10
SHARED_MEMORY_CAD_COOLDOWN_SECONDS=300

# ══ B 类高级能力 (NDR / EDR / 威胁情报 / 0day / 反钓鱼) ══
# 全部默认关闭; 演示/生产按需开启。外部依赖(抓包权限/CAPE沙箱/MISP/TAXII/邮件)见
# docs/advanced_capabilities.md。演示一键配置见 .env.demo.example。

# ── NDR 流量分析 ──
SHARED_MEMORY_CAPTURE_ENABLED=false
SHARED_MEMORY_CAPTURE_INTERFACE=eth0
SHARED_MEMORY_CAPTURE_METHOD=libpcap
SHARED_MEMORY_CAPTURE_BPF_FILTER=
SHARED_MEMORY_MITM_ENABLED=false
SHARED_MEMORY_MITM_LISTEN_PORT=8443
SHARED_MEMORY_MITM_CA_CERT=
SHARED_MEMORY_MITM_CA_KEY=

# ── EDR 融合 ──
SHARED_MEMORY_EDR_ENABLED=false
SHARED_MEMORY_EDR_CORRELATION_WINDOW=300

# ── IDS 接入 (Suricata EVE, 需 KAFKA_ENABLED 同开) ──
# pcap 回放评测不经 Kafka: 见 eval_datasets/replay_pcap_suricata.py
SHARED_MEMORY_SURICATA_ENABLED=false

# ── 威胁情报 (MISP / TAXII) ──
SHARED_MEMORY_INTEL_ENABLED=false
SHARED_MEMORY_INTEL_POLL_INTERVAL=60
# 情报富化旁路(与拉取解耦): 告警落库前匹配 IOC 缓存(IP/域名/哈希/CVE),
# KEV 命中自动提级。fail-open + 超时保护, 关闭时接入主链路零行为变化。
SHARED_MEMORY_INTEL_ENRICH_ENABLED=false
SHARED_MEMORY_INTEL_ENRICH_TIMEOUT_MS=800
SHARED_MEMORY_MISP_URL=
SHARED_MEMORY_MISP_API_KEY=
SHARED_MEMORY_MISP_VERIFY_SSL=true
SHARED_MEMORY_TAXII_URL=
SHARED_MEMORY_TAXII_USER=
SHARED_MEMORY_TAXII_PASSWORD=

# ── 0day 沙箱 (CAPE/Cuckoo) ──
SHARED_MEMORY_SANDBOX_ENABLED=false
SHARED_MEMORY_SANDBOX_TYPE=cape
SHARED_MEMORY_SANDBOX_API_URL=http://localhost:8090
SHARED_MEMORY_SANDBOX_API_KEY=
SHARED_MEMORY_SANDBOX_AUTO_SUBMIT=false
SHARED_MEMORY_SANDBOX_TIMEOUT=300

# ── B 类 LLM 增强 (可选叙事/解读; 均有日预算) ──
SHARED_MEMORY_LLM_EDR_ENABLED=false
SHARED_MEMORY_LLM_INTEL_ENABLED=false
SHARED_MEMORY_LLM_SANDBOX_ENABLED=false
SHARED_MEMORY_LLM_PHISHING_ENABLED=false
SHARED_MEMORY_LLM_EDR_BUDGET_JPY_PER_DAY=5
SHARED_MEMORY_LLM_INTEL_BUDGET_JPY_PER_DAY=3
SHARED_MEMORY_LLM_SANDBOX_BUDGET_JPY_PER_DAY=5
SHARED_MEMORY_LLM_PHISHING_BUDGET_JPY_PER_DAY=75

# ── 大屏实况面板 (A1/A2/A3: agent 实况/攻击地图/零丢失账本) ──
# 账本广播间隔秒 (SSE ledger 频道)
SHARED_MEMORY_LEDGER_INTERVAL=3
# 攻击态势广播间隔秒 / 回看事件窗口条数 / 态势点上限 (SSE attack_geo 频道)
SHARED_MEMORY_ATTACK_GEO_INTERVAL=5
SHARED_MEMORY_ATTACK_GEO_WINDOW=400
SHARED_MEMORY_ATTACK_GEO_MAX_POINTS=24
# 受击方坐标 (态势图中心, 默认湖南科技大学)
SHARED_MEMORY_HOME_LAT=27.95
SHARED_MEMORY_HOME_LON=112.93
SHARED_MEMORY_HOME_LABEL=湖南科技大学
